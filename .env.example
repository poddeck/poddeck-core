# PodDeck Control Plane Configuration
# Copy this file to .env and fill in the values

# Database
DB_USERNAME=poddeck
DB_PASSWORD=changeme
DB_DATABASE=poddeck

# JWT Authentication (32-character secrets, generate with: openssl rand -hex 16)
AUTH_KEY=
REFRESH_KEY=

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost
